# Copy this file to .env and fill your real values.
# Never commit .env (already ignored by .gitignore).

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CREATE_SUPERUSER=false
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-password
DJANGO_SUPERUSER_FIRST_NAME=Admin
DJANGO_SUPERUSER_LAST_NAME=User
DATABASE_URL=
DB_CONN_MAX_AGE=600
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
USE_X_FORWARDED_PROTO=false
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

# If BREVO_API_KEY is set, app defaults to Brevo HTTP API backend.
# You can force SMTP with:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
BREVO_API_KEY=your_brevo_api_key
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=aa8357001@smtp-brevo.com
EMAIL_HOST_PASSWORD=your_brevo_smtp_key
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=your_verified_sender@yourdomain.com

# --- Media (S3-compatible): required for multi-host / serverless DB (Neon) ---
# Without this, uploads live under MEDIA_ROOT on one machine and are invisible elsewhere.
# Set AWS_STORAGE_BUCKET_NAME to enable (or USE_S3_MEDIA=true with the same vars).
# USE_S3_MEDIA=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
# Optional: Cloudflare R2, MinIO, etc.
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_S3_ADDRESSING_STYLE=path
# Public CDN or custom domain (recommended for fast reads):
# AWS_S3_CUSTOM_DOMAIN=cdn.example.com
# Or full base URL for MEDIA_URL (overrides computed URL):
# AWS_S3_PUBLIC_MEDIA_URL=https://cdn.example.com/my-prefix
# Signed private URLs (default is unsigned URLs; bucket policy must allow GET):
# AWS_QUERYSTRING_AUTH=true
